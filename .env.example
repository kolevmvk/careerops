# Copy to .env.local (web) or .env (tooling). Never commit real values.

# Supabase (public: safe for the browser)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase (server only: never prefix with NEXT_PUBLIC_)
SUPABASE_SERVICE_ROLE_KEY=

# Signed recompute webhook (database → API route)
SCORING_WEBHOOK_SECRET=
